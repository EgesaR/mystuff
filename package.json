    "@mdx-js/rollup": "^3.1.1",
    "@react-router/node": "8.0.0",
    "@react-router/serve": "8.0.0",
    "@types/color": "^4.2.1",
    "@types/dompurify": "^3.0.5",
    "@types/uuid": "^10.0.0",
