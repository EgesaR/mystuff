{
  "name": "my-stuff",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "legacy:css": "tailwindcss -c legacy/tailwind.config.js -i ./legacy/input.css -o ./public/legacy.css --minify",
    "legacy:watch": "tailwindcss -c legacy/tailwind.config.js -i ./legacy/input.css -o ./public/legacy.css --watch",
    "dev:all": "concurrently \"npm run dev\" \"npm run legacy:watch\""
  },
